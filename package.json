{
  "name": "doujiao-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/host",
    "build:sdk": "npm run build -w packages/plugin-sdk",
    "build:plugins": "npm run build -w plugins/douyin",
    "build:host": "npm run build -w apps/host",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
