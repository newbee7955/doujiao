{
  "$schema": "https://doujiao.app/schemas/plugin-manifest.v2.json",
  "id": "notepad",
  "publisher": "doujiao-official",
  "name": "轻便记事本",
  "version": "1.1.0",
  "description": "零负担极速纯文本随手记，支持外部安全工作目录持久化存储（应用卸载不丢失）、多便签卡片、置顶备忘与字数统计",
  "icon": "🗒️",
  "engines": {
    "doujiao": ">=0.2.0 <0.3.0",
    "pluginApi": "^1.0.0"
  },
  "entrypoints": {
    "ui": "dist/index.html"
  },
  "permissions": [
    { "capability": "workspace" }
  ]
}